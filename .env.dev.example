# Copy to .env.dev locally or use the named AWS profile rms-dev.
AWS_PROFILE=rms-dev
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_PAYMENT_TOPIC_ARN=
AWS_RECONCILIATION_QUEUE_URL=
AWS_ANALYTICS_QUEUE_URL=
AWS_ANALYTICS_BUCKET=recebiveis-analytics
COGNITO_ISSUER_URI=
POSTGRES_URL=jdbc:postgresql://localhost:5432/rms
POSTGRES_USER=rms
POSTGRES_PASSWORD=change-me
APP_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
